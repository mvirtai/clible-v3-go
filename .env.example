# Clible-v3-go - Environment Variables Template (.env.example)

# Port to serve the REST API
PORT=8080

# Application environment (development / production)
ENV=development

# Database connection string
# Local SQLite development fallback:
DATABASE_URL="clible.db"
# Production Neon PostgreSQL connection:
# DATABASE_URL="postgresql://username:password@ep-host.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Directory for compiled static frontend SPA assets (served by backend in production)
FRONTEND_DIR="../frontend/dist"

# Secret key for signing JWT tokens (must be at least 32 characters long)
JWT_SECRET=generate_a_secure_long_secret_key_at_least_32_characters

# Gemini API key for AI Insights
GEMINI_API_KEY=your-gemini-api-key
